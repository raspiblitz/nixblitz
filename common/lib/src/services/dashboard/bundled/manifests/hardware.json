{
  "id": "hardware",
  "title": "Hardware",
  "accent_color": "#4caf50",
  "layout": [
    {
      "ProgressBar": {
        "label": "CPU",
        "value": { "$data": "cpu_percent" },
        "max": 100,
        "format": "percent"
      }
    },
    {
      "ProgressBar": {
        "label": "Mem",
        "value": { "$data": "mem_used_bytes" },
        "max": { "$data": "mem_total_bytes" },
        "format": "bytes"
      }
    },
    {
      "ProgressBar": {
        "label": "Disk",
        "value": { "$data": "disk_used_bytes" },
        "max": { "$data": "disk_total_bytes" },
        "format": "bytes"
      }
    },
    { "Row": { "label": "Temp", "value": { "$format": "{temperature_c}°C" } } }
  ]
}
