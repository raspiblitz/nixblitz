#!/usr/bin/env bash

# cachepop — Attic cache populator for nixblitz build hosts.
#
# Drives `nixblitz init` + `nixblitz plugin add` to seed per-target
# profile dirs, advances flake inputs on a timer, builds each target's
# system closure, pushes the closure (and its transitive deps) to an
# Attic cache. Designed to run from systemd on a beefy x86 box that
# binfmt-emulates aarch64 for Pi 5 closures the operator's actual Pi
# can't compute in reasonable time (page-size-16k jemalloc rebuild
# chain, vendored jemalloc-sys in uv / aiohttp, etc.).
#
# Config sources, in priority order:
#   1. --config FLAG
#   2. $CACHEPOP_CONFIG env var
#   3. $XDG_CONFIG_HOME/cachepop/config.json
#   4. $HOME/.config/cachepop/config.json
#   5. /etc/nixblitz-cachepop/config.json   (rendered by the NixOS module)
#
# Config schema (JSON):
#   {
#     "stateDir":      "/var/lib/nixblitz-cachepop",
#     "atticCache":    "f44:nixblitz",
#     "atticEndpoint": "https://attic.f44.fyi/",
#     "nixCores":      12,      # --cores per derivation (0 = all)
#     "nixMaxJobs":    "auto",  # --max-jobs (positive int or "auto")
#     "targets": [
#       { "name": "pi5-mainnet",
#         "flakeAttr": "nixblitz-pi5",
#         "platform":  "pi5",
#         "plugins":   ["bitcoind","lnd","blitz-api"] }
#     ]
#   }
set -euo pipefail

CACHEPOP_VERSION="0.1.0"

# ── helpers ────────────────────────────────────────────────────────────

log() { printf '%s [cachepop] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >&2; }
die() { log "error: $*"; exit 1; }

# Wall-clock timer for build commands. Logs `<label> took Ns (exit=K)`
# after the wrapped command runs, then exits with the same status. Use
# for any subprocess that's expected to take more than a few seconds
# (nix flake update, nix build, attic push, nixblitz init, plugin add)
# — gives the operator visibility into which step dominates a sync
# cycle without needing to instrument journald.
_timed() {
  local label=$1; shift
  local start rc
  start=$(date +%s)
  rc=0
  "$@" || rc=$?
  log "$label took $(($(date +%s) - start))s (exit=$rc)"
  return $rc
}

# Atomic write: render to .tmp, fsync via mv. Cheap insurance against
# partial writes if the process gets SIGTERM'd between subcommands.
atomic_write() {
  local path=$1 content=$2
  local tmp="${path}.tmp"
  printf '%s' "$content" > "$tmp"
  mv "$tmp" "$path"
}

iso_now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# ── config loading ─────────────────────────────────────────────────────

CONFIG_PATH=""
load_config() {
  local candidates=()
  if [[ -n "${CACHEPOP_CONFIG_FLAG:-}" ]]; then
    candidates+=("$CACHEPOP_CONFIG_FLAG")
  fi
  if [[ -n "${CACHEPOP_CONFIG:-}" ]]; then
    candidates+=("$CACHEPOP_CONFIG")
  fi
  candidates+=("${XDG_CONFIG_HOME:-$HOME/.config}/cachepop/config.json")
  candidates+=("$HOME/.config/cachepop/config.json")
  candidates+=("/etc/nixblitz-cachepop/config.json")

  for c in "${candidates[@]}"; do
    if [[ -f "$c" ]]; then
      CONFIG_PATH=$c
      return
    fi
  done
  die "no config found (looked in: ${candidates[*]})"
}

cfg_query() { jq -er "$1" "$CONFIG_PATH"; }
cfg_query_or_default() { jq -r "$1 // $2" "$CONFIG_PATH"; }

# ── state dir layout ───────────────────────────────────────────────────
#
# $STATE_DIR/
# ├── status.json
# └── targets/
#     └── <target-name>/
#         ├── home/                  # HOME for nixblitz invocations
#         │   └── nixblitz/          # nixblitz's profile dir
#         │       ├── config.json
#         │       ├── flake.{nix,lock}
#         │       └── plugins/...
#         ├── lock.prev.json         # last-seen flake.lock for drift compare
#         └── last-build.txt         # outPath of the last successful build

target_home()         { printf '%s/targets/%s/home' "$STATE_DIR" "$1"; }
target_profile()      { printf '%s/targets/%s/home/nixblitz' "$STATE_DIR" "$1"; }
target_lock_prev()    { printf '%s/targets/%s/lock.prev.json' "$STATE_DIR" "$1"; }
target_plugins_prev() { printf '%s/targets/%s/plugins.prev.json' "$STATE_DIR" "$1"; }
target_last_build()   { printf '%s/targets/%s/last-build.txt' "$STATE_DIR" "$1"; }

status_path() { printf '%s/status.json' "$STATE_DIR"; }

# Update a single target's entry in status.json. Reads the current file
# (creating an empty skeleton on first call), merges {<key>:<val>, …},
# writes atomically.
status_update() {
  local target=$1; shift
  local now; now=$(iso_now)

  local current="{}"
  if [[ -f "$(status_path)" ]]; then current=$(cat "$(status_path)"); fi

  local patch
  patch=$(jq -n --arg now "$now" --argjson kv "$1" \
    '{ updated_at: $now, patch: $kv }')

  local merged
  merged=$(jq --arg target "$target" --argjson p "$(echo "$patch" | jq .patch)" --arg now "$now" '
    .updated_at = $now
    | .targets //= {}
    | .targets[$target] //= {}
    | .targets[$target] += $p
  ' <<< "$current")

  atomic_write "$(status_path)" "$merged"
}

# ── lock drift ─────────────────────────────────────────────────────────

# Returns space-separated input names whose `locked.rev` differs from
# the prev snapshot. Empty output means no drift. First run with no
# prev snapshot returns "FIRST_RUN" to force a build.
lock_drift() {
  local target=$1
  local lock prev
  lock="$(target_profile "$target")/flake.lock"
  prev=$(target_lock_prev "$target")

  [[ -f "$lock" ]] || die "$target: no flake.lock — bootstrap first"

  if [[ ! -f "$prev" ]]; then
    echo "FIRST_RUN"
    return
  fi

  jq -r --slurpfile p "$prev" '
    .nodes
    | to_entries
    | map(select(.key != "root"))
    | map(select(
        (.value.locked.rev // "") != ($p[0].nodes[.key].locked.rev // "")
      ))
    | map(.key)
    | join(" ")
  ' "$lock"
}

snapshot_lock() {
  local target=$1
  local lock
  lock="$(target_profile "$target")/flake.lock"
  cp -f "$lock" "$(target_lock_prev "$target")"
}

# Plugin-rev drift detection mirrors lock_drift. Plugins aren't in
# flake.lock — they're cloned subdirectories under plugins/, each
# with its own `.nixblitz-installed.json` carrying `{ id, rev, ... }`.
# When a plugin's upstream advances, `nixblitz plugin update --all`
# rewrites the marker with the new rev; we snapshot { id: rev } maps
# pre/post and report any id whose rev changed (or appeared / went
# away).
#
# Why we care: each plugin's NixOS module pulls its own nixpkgs/
# nix-bitcoin/etc. via builtins.getFlake at the plugin's pinned rev.
# A plugin advance can introduce uv / jemalloc / Python-wheel
# rebuilds — exactly what the Attic cache is supposed to absorb.
# Flake-only drift detection would miss those entirely.
_plugin_markers_json() {
  local profile=$1
  # `jq -s` slurps all marker files into a list; .id+.rev pulled into
  # an object. The `2>/dev/null` swallows the "no such file" jq emits
  # when the glob doesn't match (no plugins installed yet).
  jq -s 'map({(.id): .rev}) | add // {}' \
    "$profile"/plugins/*/.nixblitz-installed.json 2>/dev/null || echo '{}'
}

snapshot_plugins() {
  local target=$1
  local profile; profile="$(target_profile "$target")"
  _plugin_markers_json "$profile" > "$(target_plugins_prev "$target")"
}

plugin_drift() {
  local target=$1
  local profile prev current
  profile="$(target_profile "$target")"
  prev="$(target_plugins_prev "$target")"

  if [[ ! -f "$prev" ]]; then
    echo "FIRST_RUN"
    return
  fi
  current=$(_plugin_markers_json "$profile")

  # Diff the maps — any id whose rev differs (or is missing on one
  # side) is drift. Output is space-separated plugin ids; empty
  # output means no drift. `-r` (raw) so the empty case prints an
  # empty line, not the literal JSON string `""` which would look
  # like drift to the caller's `[[ -n "$plugin_d" ]]` check.
  jq -nr --argjson cur "$current" --slurpfile p "$prev" '
    ($p[0] // {}) as $prev
    | (($cur | keys) + ($prev | keys) | unique)
      | map(select($cur[.] != $prev[.]))
      | join(" ")
  '
}

# ── subcommand: init ──────────────────────────────────────────────────

cmd_init() {
  local target="" flake_attr="" platform="" plugins=""
  while [[ $# -gt 0 ]]; do
    case $1 in
      --flake-attr) flake_attr=$2; shift 2 ;;
      --platform)   platform=$2;   shift 2 ;;
      --plugins)    plugins=$2;    shift 2 ;;
      -h|--help)    init_usage; return 0 ;;
      -*)           die "unknown flag: $1" ;;
      *)            target=$1; shift ;;
    esac
  done

  [[ -n "$target"     ]] || die "init: missing <target> name"
  [[ -n "$flake_attr" ]] || die "init: --flake-attr is required"
  [[ -n "$platform"   ]] || die "init: --platform is required"

  local home_dir profile_dir
  home_dir=$(target_home "$target")
  profile_dir=$(target_profile "$target")
  mkdir -p "$home_dir"

  if [[ -f "$profile_dir/config.json" ]]; then
    log "$target: profile already exists at $profile_dir, skipping init"
  else
    _timed "$target: nixblitz init" \
      env HOME="$home_dir" nixblitz init --platform "$platform"
  fi

  if [[ -n "$plugins" ]]; then
    IFS=',' read -ra plugin_arr <<< "$plugins"
    for p in "${plugin_arr[@]}"; do
      local marker="$profile_dir/plugins/$p/plugin.json"
      if [[ -f "$marker" ]]; then
        log "$target: plugin $p already installed, skipping"
        continue
      fi
      _timed "$target: nixblitz plugin add $p" \
        env HOME="$home_dir" nixblitz plugin add \
          "forgejo:forge.f44.fyi/f44/nixblitz_official_plugins/$p" --yes
    done
  fi

  # Flip initialized=true so installed.nix's appEnabled gate returns
  # true. The TUI's wizard handles this on a real install; we're past
  # that phase on the build host.
  local cfg="$profile_dir/config.json"
  local updated; updated=$(jq '.initialized = true' "$cfg")
  atomic_write "$cfg" "$updated"

  # Commit the post-init state so the flake's git-detection sees a
  # clean tree on the next build. `diff --cached --quiet` exits 0
  # when there's nothing staged, 1 otherwise — invert via `!` so we
  # only commit when staging produced changes.
  (
    cd "$profile_dir"
    git add .
    if ! git diff --cached --quiet; then
      git commit -m "cachepop: enable apps + plugins" >/dev/null
    fi
  )

  log "$target: initialised"
}

init_usage() {
  cat >&2 <<EOF
Usage: cachepop init <target> --flake-attr <attr> --platform <x86|pi5>
                              [--plugins p1,p2,...]
Bootstrap a per-target profile dir under \$STATE_DIR/targets/<target>/.
Idempotent: re-running skips already-initialised steps.
EOF
}

# ── subcommand: check ──────────────────────────────────────────────────

cmd_check() {
  local exit_code=0
  while read -r target; do
    local profile home_dir
    profile=$(target_profile "$target")
    home_dir=$(target_home "$target")
    [[ -d "$profile" ]] || { log "$target: not initialised, skipping"; continue; }

    # Advance flake inputs (nixpkgs, nixos-raspberrypi, …) — affects
    # the system-level closure.
    ( cd "$profile" && _timed "$target: nix flake update" \
        nix flake update --accept-flake-config )

    # Advance plugin pins — affects every plugin's getFlake-pulled
    # nixpkgs / nix-bitcoin / app sources. Missing this step means
    # cachepop only catches half the upstream drift that produces a
    # cache miss on the Pi (operator's plugin update flow is a
    # separate trigger from `nix flake update`).
    _timed "$target: nixblitz plugin update --all" \
      env HOME="$home_dir" nixblitz plugin update --all || true

    local flake_d plugin_d
    flake_d=$(lock_drift "$target")
    plugin_d=$(plugin_drift "$target")

    if [[ -z "$flake_d" && -z "$plugin_d" ]]; then
      log "$target: no drift"
    elif [[ "$flake_d" == "FIRST_RUN" || "$plugin_d" == "FIRST_RUN" ]]; then
      log "$target: first run (no prev snapshot)"
      exit_code=1
    else
      [[ -n "$flake_d"  ]] && log "$target: flake drift in: $flake_d"
      [[ -n "$plugin_d" ]] && log "$target: plugin drift in: $plugin_d"
      exit_code=1
    fi
  done < <(cfg_query '.targets[].name')
  return $exit_code
}

# ── subcommand: build ─────────────────────────────────────────────────

cmd_build() {
  local requested=("$@")
  local failed=0
  while read -r target; do
    if [[ ${#requested[@]} -gt 0 ]] && ! _in_array "$target" "${requested[@]}"; then
      continue
    fi
    if ! _build_one "$target"; then
      failed=$((failed + 1))
    fi
  done < <(cfg_query '.targets[].name')
  return $failed
}

_build_one() {
  local target=$1
  local profile flake_attr build_json out_path
  profile=$(target_profile "$target")
  flake_attr=$(cfg_query ".targets[] | select(.name==\"$target\") | .flakeAttr")

  [[ -d "$profile" ]] || { log "$target: not initialised, skipping"; return 1; }

  local attr="${profile}#nixosConfigurations.${flake_attr}.config.system.build.toplevel"

  # Build flags:
  #   -L          stream per-derivation log lines to stderr in real
  #               time. Without this nix is silent until the build
  #               finishes — operators staring at journalctl see
  #               nothing for hours.
  #   --cores     per-derivation parallelism cap. 0 = use all cores
  #               (the nix default); positive values leave headroom
  #               so this service can run while the operator uses
  #               the box. Threaded from config.nixCores.
  #   --max-jobs  derivation-level concurrency. "auto" (default) lets
  #               nix pick; positive values cap it explicitly.
  #               Threaded from config.nixMaxJobs.
  #
  # `--json` writes the result manifest to stdout; `-L` writes build
  # logs to stderr. Capturing stdout into build_json keeps the two
  # streams separated — logs flow through to journalctl unmolested.
  local cores max_jobs
  cores=$(cfg_query_or_default '.nixCores' '0')
  max_jobs=$(cfg_query_or_default '.nixMaxJobs' '"auto"')

  log "$target: nix build $attr (cores=$cores max-jobs=$max_jobs)"
  local build_start build_elapsed
  build_start=$(date +%s)
  # --accept-flake-config: even for trusted users, Nix prompts
  # before applying a flake's nixConfig (extra-substituters /
  # trusted-public-keys). cachepop runs without a TTY → no answer
  # → settings silently dropped, which defeats the whole point of
  # populating a cache we'd then substitute from on the next run.
  # The consumer flake here is templates/flake.nix which cachepop
  # itself wrote/seeded; trusting its nixConfig is correct.
  if ! build_json=$(nix build --no-link --json -L --accept-flake-config \
        --cores "$cores" --max-jobs "$max_jobs" "$attr"); then
    build_elapsed=$(($(date +%s) - build_start))
    log "$target: nix build failed after ${build_elapsed}s (see prior stderr lines)"
    status_update "$target" "$(jq -n \
        --arg err "build failed; see journalctl -u nixblitz-cachepop" \
        --argjson sec "$build_elapsed" \
      '{ last_exit_code: 1, last_error: $err, last_build_seconds: $sec }')"
    return 1
  fi
  build_elapsed=$(($(date +%s) - build_start))
  log "$target: nix build took ${build_elapsed}s (exit=0)"

  out_path=$(echo "$build_json" | jq -r '.[0].outputs.out')
  echo "$out_path" > "$(target_last_build "$target")"
  # Snapshots are NOT advanced here. They reflect the state of the
  # *remote cache*, not the local build. Advancing them after a
  # successful build but before push would hide a push failure: the
  # next `check` would see snapshot == current lock and report "no
  # drift", leaving an unpushed closure stranded forever. Advance
  # only in cmd_push's success branch.

  local now; now=$(iso_now)
  # last_built_rev tracks the nixblitz input's rev from flake.lock —
  # what upstream the closure was built against. The profile dir's
  # git HEAD (cachepop's own bootstrap commits) is irrelevant to
  # operators; use the input rev for the field so `cachepop summary`
  # shows a value the operator can correlate with `git log` on the
  # nixblitz_ng repo.
  local nixblitz_rev profile_head
  nixblitz_rev=$(jq -r '.nodes.nixblitz.locked.rev // empty' \
    "$profile/flake.lock" 2>/dev/null || echo "")
  profile_head=$( cd "$profile" && git rev-parse HEAD 2>/dev/null || echo "" )
  status_update "$target" "$(jq -n \
    --arg rev "$nixblitz_rev" --arg phead "$profile_head" \
    --arg now "$now" --arg out "$out_path" --argjson sec "$build_elapsed" \
    '{ last_built_rev: $rev,
       last_built_profile_head: $phead,
       last_built_at: $now,
       last_built_outpath: $out,
       last_build_seconds: $sec,
       last_exit_code: 0,
       last_error: null }')"
  log "$target: built $out_path (nixblitz rev=$(echo "$nixblitz_rev" | cut -c1-7))"
}

# ── subcommand: push ──────────────────────────────────────────────────

cmd_push() {
  local requested=("$@")
  local failed=0
  local cache; cache=$(cfg_query '.atticCache')

  while read -r target; do
    if [[ ${#requested[@]} -gt 0 ]] && ! _in_array "$target" "${requested[@]}"; then
      continue
    fi
    local last; last=$(target_last_build "$target")
    if [[ ! -f "$last" ]]; then
      log "$target: nothing to push (no last build)"
      continue
    fi
    local out_path push_start push_elapsed push_rc
    out_path=$(cat "$last")
    push_start=$(date +%s)
    push_rc=0
    attic push "$cache" "$out_path" || push_rc=$?
    push_elapsed=$(($(date +%s) - push_start))
    log "$target: attic push took ${push_elapsed}s (exit=$push_rc)"
    if [[ $push_rc -eq 0 ]]; then
      status_update "$target" "$(jq -n --arg now "$(iso_now)" --argjson sec "$push_elapsed" \
        '{ last_pushed_at: $now, last_push_seconds: $sec }')"
      # Only now does the snapshot advance — what's in the cache
      # matches the lock + plugin revs we just built against. If push
      # had failed, snapshot would stay at the previous successful
      # state and the next `check` would re-detect drift, prompting
      # another build (cheap, store path is local) + retry push.
      snapshot_lock "$target"
      snapshot_plugins "$target"
    else
      failed=$((failed + 1))
    fi
  done < <(cfg_query '.targets[].name')
  return $failed
}

# ── subcommand: sync ──────────────────────────────────────────────────

cmd_sync() {
  log "sync: check → build → push"
  set +e
  cmd_check; local drift_code=$?
  set -e

  if [[ $drift_code -eq 0 ]]; then
    log "sync: no drift, nothing to do"
    return 0
  fi
  if [[ $drift_code -ne 1 ]]; then
    die "sync: check failed (exit $drift_code)"
  fi

  cmd_build
  cmd_push
}

# ── subcommand: status ────────────────────────────────────────────────

cmd_status() {
  local path; path=$(status_path)
  if [[ ! -f "$path" ]]; then
    echo "no status yet — run \`cachepop sync\` first" >&2
    return 0
  fi
  jq . "$path"
}

# ── subcommand: summary ───────────────────────────────────────────────
#
# Human-readable rendering of status.json. Distinct from `status`
# (which dumps raw JSON for scripting) — operators eyeballing the
# last cycle want target name, last-built rev / time, durations,
# pass/fail state at a glance.

cmd_summary() {
  local path; path=$(status_path)
  if [[ ! -f "$path" ]]; then
    echo "no status yet — run \`cachepop sync\` first" >&2
    return 0
  fi

  local updated; updated=$(jq -r '.updated_at // "(never)"' "$path")
  printf 'cachepop status — last updated %s\n\n' "$updated"

  jq -r '
    .targets // {} | to_entries[] |
    "\(.key)\t\(.value.last_exit_code // "?")\t\(.value.last_built_rev // "-")\t\(.value.last_built_at // "-")\t\(.value.last_build_seconds // "-")s\t\(.value.last_pushed_at // "(not pushed)")\t\(.value.last_push_seconds // "-")s\t\(.value.last_error // "")"
  ' "$path" \
    | column -t -s $'\t' \
        -N target,exit,rev,built_at,build,pushed_at,push,error
}

# ── subcommand: dry-run ───────────────────────────────────────────────
#
# Run `nix build --dry-run -L` per target to enumerate what would
# compile vs what substitutes. Useful before manually firing `sync`
# on a constrained machine — operator sees "17 packages would need
# to compile" and can decide whether to start the build now or wait.

cmd_dry_run() {
  local requested=("$@")
  while read -r target; do
    if [[ ${#requested[@]} -gt 0 ]] && ! _in_array "$target" "${requested[@]}"; then
      continue
    fi
    local profile flake_attr attr
    profile=$(target_profile "$target")
    flake_attr=$(cfg_query ".targets[] | select(.name==\"$target\") | .flakeAttr")
    [[ -d "$profile" ]] || { log "$target: not initialised, skipping"; continue; }

    attr="${profile}#nixosConfigurations.${flake_attr}.config.system.build.toplevel"
    log "$target: nix build --dry-run $attr"
    # Dry-run output ("X derivations will be built ... Y paths will
    # be fetched ...") goes to stderr. Let it flow to the terminal /
    # journal; we don't need to parse it here — the human-readable
    # form is the deliverable.
    nix build --dry-run -L --accept-flake-config "$attr" || true
  done < <(cfg_query '.targets[].name')
}

# ── subcommand: logs ──────────────────────────────────────────────────
#
# Thin wrapper around `journalctl -u nixblitz-cachepop.service`.
# Saves the operator from typing the full unit name and remembering
# the -fu / -n conventions. Forwards unknown args to journalctl so
# `cachepop logs --since=1h` etc. still work.

cmd_logs() {
  local follow=0 lines=200
  local passthrough=()
  while [[ $# -gt 0 ]]; do
    case $1 in
      -f|--follow)  follow=1; shift ;;
      -n|--lines)   lines=$2; shift 2 ;;
      -h|--help)
        cat >&2 <<EOF
Usage: cachepop logs [-f|--follow] [-n N] [-- journalctl-args...]
  -f, --follow  tail the journal (Ctrl-C to exit)
  -n N          show the last N lines (default 200)
  Anything after -- is forwarded to journalctl verbatim.
EOF
        return 0
        ;;
      --) shift; passthrough+=("$@"); break ;;
      *)  passthrough+=("$1"); shift ;;
    esac
  done

  local jargs=(-u nixblitz-cachepop.service -n "$lines")
  [[ $follow -eq 1 ]] && jargs+=(-f)
  jargs+=("${passthrough[@]}")
  journalctl "${jargs[@]}"
}

# ── dispatch ──────────────────────────────────────────────────────────

_in_array() {
  local needle=$1; shift
  for x in "$@"; do [[ "$x" == "$needle" ]] && return 0; done
  return 1
}

main_usage() {
  cat >&2 <<EOF
cachepop $CACHEPOP_VERSION — Attic cache populator for nixblitz

Usage: cachepop [--config PATH] <subcommand> [args...]

Subcommands:
  init <target> --flake-attr <attr> --platform <x86|pi5> [--plugins p1,p2,...]
                          Bootstrap a per-target profile dir.
  check                   Advance flake inputs, report drift.
  dry-run [<target>...]   Show what would compile vs substitute (no build).
  build [<target>...]     Build each target's closure. All if none named.
  push [<target>...]      Push last build to Attic. All if none named.
  sync                    check → if drift: build + push. Service entry point.
  status                  Raw status JSON (for scripting).
  summary                 Human-readable last-cycle summary.
  logs [-f] [-n N]        Tail the systemd journal for the service.
  --version               Print version and exit.
  --help                  Print this help.
EOF
}

# Subcommands that touch the state-dir / per-target profile / flake
# repo. When invoked by a user whose uid doesn't match the stateDir
# owner, libgit2's safe.directory check rejects the operation —
# `nix build` (even --dry-run) opens the flake repo via libgit2 and
# refuses to proceed. Auto-elevate these to the owning user via
# `sudo -u`. Read-only commands skip the dance.
_needs_owner_uid() {
  case $1 in
    init | check | dry-run | build | push | sync) return 0 ;;
    *) return 1 ;;
  esac
}

# Re-exec as the stateDir's owner if the current uid doesn't match.
# Guarded against infinite loops via CACHEPOP_REEXECED. Operator's
# password prompt fires once per sudo timeout (typically 5 min).
#
# `sudo -H` sets HOME to the target user's passwd entry (instead of
# leaking the caller's /home/<user> in, which libgit2 then tries to
# stat for ~/.gitconfig and fails on permission). Inline `env` carries
# the recursion-guard var across sudo's env_reset.
_reexec_as_owner_if_needed() {
  [[ -n "${CACHEPOP_REEXECED:-}" ]] && return
  [[ -d "$STATE_DIR" ]] || return
  local owner_uid; owner_uid=$(stat -c '%u' "$STATE_DIR" 2>/dev/null) || return
  [[ "$owner_uid" -eq "$(id -u)" ]] && return
  local owner_name; owner_name=$(getent passwd "$owner_uid" | cut -d: -f1)
  [[ -z "$owner_name" ]] && die "stateDir owned by uid $owner_uid (no passwd entry); run as that user yourself"
  log "elevating to user $owner_name (stateDir owner) via sudo"
  exec sudo -H -u "$owner_name" env CACHEPOP_REEXECED=1 "${ORIG_ARGV[@]}"
}

main() {
  # Snapshot original argv before we shift through global flags —
  # auto-elevation re-execs with the same command line.
  ORIG_ARGV=("$0" "$@")

  while [[ $# -gt 0 ]]; do
    case $1 in
      --config)  CACHEPOP_CONFIG_FLAG=$2; shift 2 ;;
      --version) echo "cachepop $CACHEPOP_VERSION"; exit 0 ;;
      -h|--help) main_usage; exit 0 ;;
      *)         break ;;
    esac
  done

  [[ $# -gt 0 ]] || { main_usage; exit 2; }

  local subcmd=$1; shift
  load_config
  STATE_DIR=$(cfg_query_or_default '.stateDir' '"/var/lib/nixblitz-cachepop"')

  if _needs_owner_uid "$subcmd"; then
    _reexec_as_owner_if_needed
  fi

  mkdir -p "$STATE_DIR/targets" 2>/dev/null || true

  case $subcmd in
    init)    cmd_init    "$@" ;;
    check)   cmd_check   "$@" ;;
    dry-run) cmd_dry_run "$@" ;;
    build)   cmd_build   "$@" ;;
    push)    cmd_push    "$@" ;;
    sync)    cmd_sync    "$@" ;;
    status)  cmd_status  "$@" ;;
    summary) cmd_summary "$@" ;;
    logs)    cmd_logs    "$@" ;;
    *)       die "unknown subcommand: $subcmd" ;;
  esac
}

main "$@"
